# Haruka Scene v5
# Spatial audio listening check (2026-11-09, Docs/Audio_Design.md 9-4 ~ 9-6). Walk with WASD (E/Q up/down), look by
# dragging with the right mouse button in the viewport during Play, or play in VR. Three stations, each only audible nearby:
#   yellow  FrontBeep    3 m ahead of the start: direction. Turn around it; with HRTF on (Edit > Audio Output, use
#                        headphones) it should sound in front / behind / above, not only left / right.
#   red     WallNoise    to the right, behind the gray wall: occlusion. Behind the wall it is quieter and duller; step
#                        out past the wall's end (toward +Z) and it opens up over about 0.1 s.
#   blue    RoomBeep     to the left, inside the blue floor (a 3 s reverb zone): reverb. Walk onto the blue floor and the
#                        tail fades in; walk off and it fades out.
ACTOR:Sun
POS:0 0 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:1 1 1
ACTIVE:1
COMPONENT:LightComponent
enabled=1
type=directional
color=1 1 1
intensity=3
attenuationRadius=10
innerConeAngle=15
outerConeAngle=30
direction=0.37139067 0.74278134 0.557086
useTemperature=0
temperatureK=6500
castShadows=1
END_COMPONENT
END_ACTOR
ACTOR:Ground
POS:0 -0.1 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:40 0.2 40
ACTIVE:1
COMPONENT:StaticMeshComponent
enabled=1
visible=1
transparent=0
prim=box|0x0|0|0.0000
primMaterial=color B4B4B4FF 0 0.6
END_COMPONENT
COMPONENT:RigidBodyComponent
enabled=1
shape=box
motion=static
friction=0.6
restitution=0.1
mass=1
halfExtent=0.5 0.5 0.5
END_COMPONENT
END_ACTOR
ACTOR:XrPlayer
POS:0 0 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:1 1 1
ACTIVE:1
COMPONENT:XrRigComponent
enabled=1
height=tracked
eyeHeight=1.7
END_COMPONENT
COMPONENT:RigLocomotionComponent
enabled=1
moveSpeed=2
snapTurn=45
flying=0
lookSensitivity=0.15
END_COMPONENT
END_ACTOR
ACTOR:Head
