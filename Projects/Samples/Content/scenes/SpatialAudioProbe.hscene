ROT:0 0 0
QUAT:0 0 0 1
SCALE:1 1 1
ACTIVE:1
PARENT:2
COMPONENT:CameraComponent
enabled=1
fovY=75
zNear=0.05
zFar=1000
primary=1
END_COMPONENT
COMPONENT:TrackedPoseComponent
enabled=1
source=head
showDebug=0
END_COMPONENT
END_ACTOR
ACTOR:FrontBeep
POS:0 1.5 -3
ROT:0 0 0
QUAT:0 0 0 1
SCALE:0.3 0.3 0.3
ACTIVE:1
COMPONENT:StaticMeshComponent
enabled=1
visible=1
transparent=0
prim=sphere|32x16|0|0.0000
primMaterial=color E6C84AFF 0 0.5
END_COMPONENT
COMPONENT:AudioComponent
enabled=1
file=/Game/audio/Test_BeepLoop.wav
volume=0.8
loop=1
autoPlay=1
attenuation=1 linear 1 8 1
occlusion=0 1200 0.4 0.1 0
reverbSend=1
reverbReach=0.5
END_COMPONENT
END_ACTOR
