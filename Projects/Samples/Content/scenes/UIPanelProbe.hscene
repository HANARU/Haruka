# Haruka Scene v5
# 3D UI panel probe (2026-11-16, P1). A front-facing panel and a turned, two-sided panel in front of the player.
# Panel pixels skip exposure, AO, bloom and tone mapping, so the colors match the editor UI.
ACTOR:Sun
POS:0 0 0
ROT:-50 0 0
QUAT:-0.42261826 0 0 0.90630779
SCALE:1 1 1
ACTIVE:1
COMPONENT:LightComponent
enabled=1
type=directional
color=1 1 1
intensity=3
attenuationRadius=10
innerConeAngle=15
outerConeAngle=30
useTemperature=0
temperatureK=6500
castShadows=1
END_COMPONENT
END_ACTOR
