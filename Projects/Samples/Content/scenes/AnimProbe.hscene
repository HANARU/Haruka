# Haruka Scene v6
# Animation probe (2026-11-20, Docs/Animation_System.md A6-4). TestArm columns play glTF clips during Play:
# left = Wave (LINEAR / STEP rotation), middle = Bounce (CUBICSPLINE root translation, hand scale), right = Flex (morph weight).
# The blue quad (TestMorph, no skin) lifts its top edge with a STEP morph clip. Use --fixed-dt for repeatable captures.
ACTOR:Sun
GUID:a17a000000000001
POS:0 0 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:1 1 1
ACTIVE:1
COMPONENT:LightComponent
enabled=1
type=directional
color=1 1 1
intensity=3
attenuationRadius=10
innerConeAngle=15
outerConeAngle=30
direction=0.37139067 0.74278134 0.557086
useTemperature=0
temperatureK=6500
castShadows=1
END_COMPONENT
END_ACTOR
