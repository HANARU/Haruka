# ── Build output (CMake / MSVC) — 1.2GB, never track ──
/build/

# ── Logs (build logs, run output) ──
/Logs/
# 실행 로그는 Logs/HarukaEngine.log(HLog 파일 출력처)와 Logs/stdout.txt(헤드리스 stdio)입니다.
# 루트의 HarukaEngine.log 는 2026-09-17 이전 빌드가 남긴 파일입니다.
/HarukaEngine.log

# ── Visual Studio / MSVC local ──
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# ── Editor per-user state ──
/Config/editor_layout.txt
/Config/editor_log.txt
/Config/log_levels.txt

# ── Scene saves (user data; run un-ignore if you want scenes versioned) ──
*.hscene
# 엔진이 읽는 시작 씬은 저장소에 둡니다(DefaultGameModule::onStart).
!/assets/scenes/*.hscene

# ── Session handoff (transient working notes, paste-in convention) ──
/SESSION_HANDOFF.md

# ── Machine-specific launcher shortcut (absolute path; kept on disk, not tracked) ──
/HarukaEngine.lnk

# ── Claude local (machine-specific) settings ──
.claude/settings.local.json

# ── Office 임시 잠금 파일(문서를 연 동안만 생기는 파일) ──
~$*

# ── OS cruft ──
Thumbs.db
Desktop.ini
.DS_Store
