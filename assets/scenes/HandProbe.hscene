# Haruka Scene v4
# Hand probe (2026-11-07, Docs/Hand_Grasp_Design.md 4-1). Skinned test gloves posed by HandPoseComponent:
# left = open hand, middle = fist, right = pointing. Check skinning, finger bend direction and shadows.
# Gloves are turned 90 degrees (fingers toward -X) so the camera sees them from the side. The camera looks straight ahead
# (desktop and headless captures keep only the camera yaw).
ACTOR:Sun
POS:0 0 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:1 1 1
ACTIVE:1
COMPONENT:LightComponent
enabled=1
type=directional
color=1 1 1
intensity=3
attenuationRadius=10
innerConeAngle=15
outerConeAngle=30
direction=0.37139067 0.74278134 0.557086
useTemperature=0
temperatureK=6500
castShadows=1
END_COMPONENT
END_ACTOR
ACTOR:Ground
POS:0 -0.1 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:20 0.2 20
ACTIVE:1
COMPONENT:StaticMeshComponent
enabled=1
visible=1
transparent=0
prim=box|0x0|0|0.0000
primMaterial=color B4B4B4FF 0 0.6
END_COMPONENT
END_ACTOR
ACTOR:Table
POS:0 0.9 0
ROT:0 0 0
QUAT:0 0 0 1
SCALE:1.2 0.05 0.4
ACTIVE:1
COMPONENT:StaticMeshComponent
enabled=1
visible=1
transparent=0
prim=box|0x0|0|0.0000
primMaterial=color 3A4250FF 0 0.7
END_COMPONENT
END_ACTOR
ACTOR:Camera
POS:0 1.05 0.68
ROT:0 0 0
QUAT:0 0 0 1
SCALE:1 1 1
ACTIVE:1
COMPONENT:CameraComponent
enabled=1
fovY=75
zNear=0.05
zFar=1000
primary=1
END_COMPONENT
END_ACTOR
ACTOR:LeftGloveOpen
POS:-0.3 1.0 0
ROT:0 90 0
QUAT:0 0.70710678 0 0.70710678
SCALE:1 1 1
ACTIVE:1
COMPONENT:SkinnedMeshComponent
enabled=1
visible=1
transparent=0
model=assets/models/hands/TestGlove_L.glb
meshIndex=0
END_COMPONENT
COMPONENT:HandPoseComponent
enabled=1
curl=0 0 0 0 0
END_COMPONENT
END_ACTOR
