# ── Haruka 엔진 찾기 (E3, Docs/Engine_Install_Design.md 5.4 · 9절) ──────────
# 프로젝트 CMakeLists.txt 가 find_package(Haruka CONFIG REQUIRED) 전에 include 하면
# 아래 순서로 Haruka_DIR 을 정합니다:
#   1. 명시 -DHaruka_DIR
#   2. 프로젝트 폴더의 기계별 덮어쓰기 (Haruka.user.ini, git 제외)
#   3. 프로젝트 상위 폴더를 거슬러 엔진 소스 트리 찾기 (저장소 안 프로젝트)
#   4. 엔진 목록 파일 (HARUKA_ENGINES_INI 또는 %LOCALAPPDATA%/Haruka/Engines.ini) 에서
#      .hproject 의 engine 조건을 만족하는 가장 높은 판

function(_haruka_finder_resolve_override_dir _raw _out_var)
    file(TO_CMAKE_PATH "${_raw}" _p)
    if(EXISTS "${_p}/HarukaConfig.cmake")
        set(${_out_var} "${_p}" PARENT_SCOPE)
    elseif(EXISTS "${_p}/build/HarukaConfig.cmake")
        set(${_out_var} "${_p}/build" PARENT_SCOPE)
    elseif(EXISTS "${_p}/Build/HarukaConfig.cmake")
        set(${_out_var} "${_p}/Build" PARENT_SCOPE)
    else()
        set(${_out_var} "" PARENT_SCOPE)
    endif()
endfunction()

function(_haruka_finder_version_matches _ver _op _req _out_var)
    if("${_op}" STREQUAL "")
        set(${_out_var} TRUE PARENT_SCOPE)
        return()
    endif()
    if("${_op}" STREQUAL ">=")
        if(_ver VERSION_GREATER_EQUAL _req)
            set(${_out_var} TRUE PARENT_SCOPE)
        else()
            set(${_out_var} FALSE PARENT_SCOPE)
        endif()
    elseif("${_op}" STREQUAL ">")
        if(_ver VERSION_GREATER _req)
            set(${_out_var} TRUE PARENT_SCOPE)
        else()
            set(${_out_var} FALSE PARENT_SCOPE)
        endif()
    elseif("${_op}" STREQUAL "==")
        if(_ver VERSION_EQUAL _req)
            set(${_out_var} TRUE PARENT_SCOPE)
        else()
            set(${_out_var} FALSE PARENT_SCOPE)
        endif()
    elseif("${_op}" STREQUAL "<=")
        if(_ver VERSION_LESS_EQUAL _req)
            set(${_out_var} TRUE PARENT_SCOPE)
        else()
            set(${_out_var} FALSE PARENT_SCOPE)
        endif()
    elseif("${_op}" STREQUAL "<")
        if(_ver VERSION_LESS _req)
            set(${_out_var} TRUE PARENT_SCOPE)
        else()
            set(${_out_var} FALSE PARENT_SCOPE)
        endif()
    else()
        set(${_out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(haruka_find_engine)
    # 1. 명시 -DHaruka_DIR
    if(DEFINED Haruka_DIR AND NOT "${Haruka_DIR}" STREQUAL "" AND NOT "${Haruka_DIR}" STREQUAL "Haruka_DIR-NOTFOUND")
        file(TO_CMAKE_PATH "${Haruka_DIR}" _explicit_dir)
        if(EXISTS "${_explicit_dir}/HarukaConfig.cmake")
            set(Haruka_DIR "${_explicit_dir}" CACHE PATH "Path to HarukaConfig.cmake" FORCE)
            return()
        endif()
        message(FATAL_ERROR
            "Haruka: -DHaruka_DIR='${Haruka_DIR}' does not contain HarukaConfig.cmake. "
            "Run Setup.bat in the engine folder or pass a valid engine build directory.")
    endif()

    # 2. 프로젝트 기계별 덮어쓰기 (Haruka.user.ini)
    set(_user_ini "${CMAKE_CURRENT_SOURCE_DIR}/Haruka.user.ini")
    if(EXISTS "${_user_ini}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_user_ini}")
        file(STRINGS "${_user_ini}" _ulines ENCODING UTF-8)
        set(_override_raw "")
        foreach(_line IN LISTS _ulines)
            string(STRIP "${_line}" _t)
            if(_t STREQUAL "" OR _t MATCHES "^[#;]")
                continue()
            endif()
            string(FIND "${_t}" "=" _eq)
            if(_eq EQUAL -1)
                message(FATAL_ERROR "Haruka: Malformed '${_user_ini}': expected 'key = value'.")
            endif()
            string(SUBSTRING "${_t}" 0 ${_eq} _k)
            math(EXPR _vs "${_eq} + 1")
            string(SUBSTRING "${_t}" ${_vs} -1 _v)
            string(STRIP "${_k}" _k)
            string(STRIP "${_v}" _v)
            if(_k STREQUAL "harukaDir" OR _k STREQUAL "buildDir" OR _k STREQUAL "engineDir")
                set(_override_raw "${_v}")
            endif()
        endforeach()
        if(NOT "${_override_raw}" STREQUAL "")
            _haruka_finder_resolve_override_dir("${_override_raw}" _resolved)
            if(NOT "${_resolved}" STREQUAL "")
                set(Haruka_DIR "${_resolved}" CACHE PATH "Path to HarukaConfig.cmake" FORCE)
                message(STATUS "HarukaEngineFinder: using Haruka.user.ini override (${_resolved})")
                return()
            endif()
            message(FATAL_ERROR
                "Haruka: Haruka.user.ini points to '${_override_raw}', which does not contain HarukaConfig.cmake. "
                "Update '${_user_ini}' or run Setup.bat in the engine folder.")
        endif()
    endif()

    # 3. 프로젝트 상위 폴더를 거슬러 엔진 소스 트리 찾기
    set(_cur "${CMAKE_CURRENT_SOURCE_DIR}")
    foreach(_depth RANGE 0 16)
        if(EXISTS "${_cur}/CMakeLists.txt" AND EXISTS "${_cur}/cmake/HarukaProject.cmake")
            file(READ "${_cur}/CMakeLists.txt" _top_cmake LIMIT 1024)
            if(_top_cmake MATCHES "project\\(HarukaEngine")
                if(EXISTS "${_cur}/build/HarukaConfig.cmake")
                    set(Haruka_DIR "${_cur}/build" CACHE PATH "Path to HarukaConfig.cmake" FORCE)
                    message(STATUS "HarukaEngineFinder: using enclosing engine tree (${_cur}/build)")
                    return()
                elseif(EXISTS "${_cur}/Build/HarukaConfig.cmake")
                    set(Haruka_DIR "${_cur}/Build" CACHE PATH "Path to HarukaConfig.cmake" FORCE)
                    message(STATUS "HarukaEngineFinder: using enclosing engine tree (${_cur}/Build)")
                    return()
                endif()
                message(FATAL_ERROR
                    "Haruka: Found engine source tree at '${_cur}', but HarukaConfig.cmake was not found in '${_cur}/build'. "
                    "Run Setup.bat in '${_cur}' first.")
            endif()
        endif()
        get_filename_component(_parent "${_cur}" DIRECTORY)
        if("${_parent}" STREQUAL "${_cur}" OR "${_parent}" STREQUAL "")
            break()
        endif()
        set(_cur "${_parent}")
    endforeach()

    # 4. .hproject 의 engine 조건과 Engines.ini 목록으로 찾기
    file(GLOB _hproj_files LIST_DIRECTORIES false CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.hproject")
    if(NOT _hproj_files)
        message(FATAL_ERROR "HarukaEngineFinder: no .hproject file in '${CMAKE_CURRENT_SOURCE_DIR}'.")
    endif()
    list(SORT _hproj_files)
    list(GET _hproj_files 0 _hproj_file)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_hproj_file}")

    file(STRINGS "${_hproj_file}" _hlines ENCODING UTF-8)
    set(_engine_spec "")
    set(_engine_ver "")
    foreach(_line IN LISTS _hlines)
        string(STRIP "${_line}" _t)
        if(_t STREQUAL "" OR _t MATCHES "^#")
            continue()
        endif()
        string(FIND "${_t}" "=" _eq)
        if(_eq EQUAL -1)
            continue()
        endif()
        string(SUBSTRING "${_t}" 0 ${_eq} _k)
        math(EXPR _vs "${_eq} + 1")
        string(SUBSTRING "${_t}" ${_vs} -1 _v)
        string(STRIP "${_k}" _k)
        string(STRIP "${_v}" _v)
        if(_k STREQUAL "engine")
            set(_engine_spec "${_v}")
        elseif(_k STREQUAL "engineVersion")
            set(_engine_ver "${_v}")
        endif()
    endforeach()

    if("${_engine_spec}" STREQUAL "")
        if(NOT "${_engine_ver}" STREQUAL "")
            set(_engine_spec "haruka>=${_engine_ver}")
        else()
            set(_engine_spec "haruka")
        endif()
    endif()

    if(_engine_spec MATCHES "^([A-Za-z0-9_-]+)[ \t]*(>=|<=|==|>|<)[ \t]*([0-9]+(\\.[0-9]+)*)$")
        set(_req_name "${CMAKE_MATCH_1}")
        set(_req_op "${CMAKE_MATCH_2}")
        set(_req_ver "${CMAKE_MATCH_3}")
    elseif(_engine_spec MATCHES "^([A-Za-z0-9_-]+)$")
        set(_req_name "${CMAKE_MATCH_1}")
        set(_req_op "")
        set(_req_ver "")
    else()
        message(FATAL_ERROR
            "Haruka: Invalid engine requirement '${_engine_spec}' in '${_hproj_file}'. "
            "Expected format such as 'haruka>=0.1'.")
    endif()
    string(TOLOWER "${_req_name}" _req_name_lower)

    set(_ini_path "")
    if(DEFINED ENV{HARUKA_ENGINES_INI} AND NOT "$ENV{HARUKA_ENGINES_INI}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{HARUKA_ENGINES_INI}" _ini_path)
    elseif(DEFINED ENV{LOCALAPPDATA} AND NOT "$ENV{LOCALAPPDATA}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}/Haruka/Engines.ini" _ini_path)
    else()
        message(FATAL_ERROR
            "Haruka: Cannot locate Engines.ini (neither HARUKA_ENGINES_INI nor LOCALAPPDATA is set). "
            "Run Setup.bat in the engine folder or pass -DHaruka_DIR=<engine>/build.")
    endif()

    if(NOT EXISTS "${_ini_path}")
        message(FATAL_ERROR
            "Haruka: Engine registry '${_ini_path}' not found. "
            "Run Setup.bat in the Haruka engine folder to register an engine, or pass -DHaruka_DIR=<engine>/build.")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_ini_path}")

    file(STRINGS "${_ini_path}" _ini_lines ENCODING UTF-8)
    set(_in_sec FALSE)
    set(_sec_name "")
    set(_sec_ver "")
    set(_sec_edir "")
    set(_sec_bdir "")
    set(_best_ver "")
    set(_best_bdir "")
    set(_matched_count 0)
    set(_missing_example "")

    macro(_haruka_finder_flush_section)
        if(_in_sec)
            if("${_sec_name}" STREQUAL "" OR "${_sec_ver}" STREQUAL "" OR "${_sec_edir}" STREQUAL "" OR "${_sec_bdir}" STREQUAL "")
                message(FATAL_ERROR
                    "Haruka: Malformed engine registry '${_ini_path}': section missing required key (name, version, engineDir, buildDir). "
                    "Re-run Setup.bat --skip-build in the engine folder to regenerate it.")
            endif()
            if(NOT _sec_ver MATCHES "^[0-9]+(\\.[0-9]+)*$")
                message(FATAL_ERROR
                    "Haruka: Malformed engine registry '${_ini_path}': invalid version '${_sec_ver}'.")
            endif()
            string(TOLOWER "${_sec_name}" _sec_name_lower)
            if("${_sec_name_lower}" STREQUAL "${_req_name_lower}")
                _haruka_finder_version_matches("${_sec_ver}" "${_req_op}" "${_req_ver}" _ok)
                if(_ok)
                    math(EXPR _matched_count "${_matched_count} + 1")
                    if(EXISTS "${_sec_edir}" AND EXISTS "${_sec_bdir}/HarukaConfig.cmake")
                        if("${_best_bdir}" STREQUAL "" OR _sec_ver VERSION_GREATER _best_ver)
                            set(_best_ver "${_sec_ver}")
                            set(_best_bdir "${_sec_bdir}")
                        endif()
                    else()
                        set(_missing_example "${_sec_name} ${_sec_ver} at '${_sec_bdir}'")
                    endif()
                endif()
            endif()
        endif()
    endmacro()

    set(_line_no 0)
    foreach(_line IN LISTS _ini_lines)
        math(EXPR _line_no "${_line_no} + 1")
        string(STRIP "${_line}" _t)
        if(_t STREQUAL "" OR _t MATCHES "^[#;]")
            continue()
        endif()
        if(_t MATCHES "^\\[(.+)\\]$")
            _haruka_finder_flush_section()
            set(_in_sec TRUE)
            set(_sec_name "")
            set(_sec_ver "")
            set(_sec_edir "")
            set(_sec_bdir "")
        else()
            if(NOT _in_sec)
                message(FATAL_ERROR
                    "Haruka: Malformed engine registry '${_ini_path}' at line ${_line_no}: key-value outside [section].")
            endif()
            string(FIND "${_t}" "=" _eq)
            if(_eq EQUAL -1)
                message(FATAL_ERROR
                    "Haruka: Malformed engine registry '${_ini_path}' at line ${_line_no}: expected 'key = value'.")
            endif()
            string(SUBSTRING "${_t}" 0 ${_eq} _k)
            math(EXPR _vs "${_eq} + 1")
            string(SUBSTRING "${_t}" ${_vs} -1 _v)
            string(STRIP "${_k}" _k)
            string(STRIP "${_v}" _v)
            if(_k STREQUAL "name")
                set(_sec_name "${_v}")
            elseif(_k STREQUAL "version")
                set(_sec_ver "${_v}")
            elseif(_k STREQUAL "engineDir")
                file(TO_CMAKE_PATH "${_v}" _sec_edir)
            elseif(_k STREQUAL "buildDir")
                file(TO_CMAKE_PATH "${_v}" _sec_bdir)
            else()
                message(FATAL_ERROR
                    "Haruka: Malformed engine registry '${_ini_path}' at line ${_line_no}: unknown key '${_k}'.")
            endif()
        endif()
    endforeach()
    _haruka_finder_flush_section()

    if(NOT "${_best_bdir}" STREQUAL "")
        set(Haruka_DIR "${_best_bdir}" CACHE PATH "Path to HarukaConfig.cmake" FORCE)
        message(STATUS "HarukaEngineFinder: selected ${_req_name} ${_best_ver} (${_best_bdir})")
        return()
    endif()

    if(_matched_count GREATER 0)
        message(FATAL_ERROR
            "Haruka: Registered engine (${_missing_example}) in '${_ini_path}' was not found on disk (folder moved or not built). "
            "Run Setup.bat in the new engine folder.")
    endif()

    message(FATAL_ERROR
        "Haruka: No registered engine in '${_ini_path}' satisfies '${_engine_spec}'. "
        "Run Setup.bat in a compatible Haruka engine folder.")
endfunction()

haruka_find_engine()
