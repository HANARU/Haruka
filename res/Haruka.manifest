<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Haruka Engine - application manifest (2026-10-19). ASCII only, like Haruka.rc.

  activeCodePage UTF-8 makes the process ANSI code page UTF-8 (Windows 10 1903 and later).
  The engine passes paths around as std::string. Without this, std::filesystem and the C runtime
  read those strings in the system code page (CP949 on Korean Windows), so a user folder name such
  as a Korean user name under %LOCALAPPDATA% could not round-trip. With it, std::string paths are
  UTF-8 everywhere. The linker merges this file with the manifest it generates (CMake passes it
  through /MANIFESTINPUT).
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
